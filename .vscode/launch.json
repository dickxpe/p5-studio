{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Build & Debug",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"${workspaceFolder}/dist/**/*.js",
				"${workspaceFolder}/extension.js"
			],
			"preLaunchTask": "npm: build"
		},
        {
			"name": "Debug",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"${workspaceFolder}/dist/**/*.js",
				"${workspaceFolder}/extension.js"
			]
		}
	]
}